# --------- CORS ---------
# Domínios autorizados a chamar a API (separados por vírgula).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --------- Resend (e-mail) ---------
# Crie sua chave em https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remetente: use "onboarding@resend.dev" até verificar seu domínio no Resend.
MAIL_FROM=onboarding@resend.dev
MAIL_TO=viniciusbelchior2017@gmail.com

# --------- Misc ---------
LOG_LEVEL=INFO
PORT=8000
